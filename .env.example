# Copy this file to .env.local and adjust if needed.
# Nothing here is secret — CookieFortune never holds a private key,
# every transaction is signed by the visitor's own connected wallet.

# Cookie Chain JSON-RPC endpoint (Solana-compatible)
VITE_RPC_URL=https://rpc.cookiescan.io

# Cookie Chain WebSocket endpoint (used for live-confirming transactions)
VITE_WS_URL=wss://wss.cookiescan.io

# Cookiescan explorer base URL used to build "view transaction" links.
# Verify this pattern on https://cookiescan.io against a real tx before
# relying on it — swap it here if Cookiescan uses a different path.
VITE_EXPLORER_TX_URL=https://cookiescan.io/tx/

# Tag every CookieFortune memo is prefixed with, so the wall can tell its
# own posts apart from unrelated memo traffic on the chain. Change this if
# you fork the app so your feed doesn't mix with the original's.
VITE_APP_TAG=COOKIEFORTUNE_V1
